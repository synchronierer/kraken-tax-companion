APP_ENV=development
APP_LOG_LEVEL=INFO
APP_DATABASE_URL=sqlite:////data/kraken-tax-companion.db
APP_CORS_ORIGINS=["http://localhost:5173"]
APP_COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
APP_COINGECKO_API_MODE=disabled
APP_COINGECKO_API_KEY=
APP_COINGECKO_TIMEOUT_SECONDS=15
# Optionaler, ausschließlich lesender Kraken-Ledger-Zugriff. Leer = deaktiviert.
APP_KRAKEN_API_KEY=
APP_KRAKEN_API_SECRET=
APP_KRAKEN_API_BASE_URL=https://api.kraken.com
APP_KRAKEN_API_TIMEOUT=15
APP_KRAKEN_API_MAX_RETRIES=2
APP_EXPORT_DIRECTORY=/exports
# Host-Portfreigaben; für isolierte Prüfungen können freie Ports gesetzt werden.
BACKEND_PORT=8000
FRONTEND_PORT=5173
# Empty means same-origin via the frontend Nginx proxy (recommended).
VITE_API_BASE_URL=
